{
  "name": "rn-smart-tour",
  "version": "1.0.8",
  "description": "Product tours, guided walkthroughs and onboarding overlays for React Native.",
  "author": "Vishwas Gaur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vishwasgaur0819/rn-smart-tour.git"
  },
  "bugs": {
    "url": "https://github.com/Vishwasgaur0819/rn-smart-tour/issues"
  },
  "homepage": "https://github.com/Vishwasgaur0819/rn-smart-tour#readme",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "keywords": [
    "react-native",
    "tour",
    "walkthrough",
    "onboarding",
    "dap",
    "guide",
    "product-tour",
    "tooltip",
    "overlay",
    "digital-adoption"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest --no-watchman",
    "prepack": "bob build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.65.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "^0.73.21",
    "@react-native/eslint-config": "^0.73.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "react": "18.2.0",
    "react-native": "0.73.11",
    "react-native-builder-bob": "^0.43.2",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
